
[Setup]
AppName=AUREXA CORE
AppVersion=1.0
AppPublisher=Fenix Boreal
DefaultDirName={pf}\AUREXA
DefaultGroupName=AUREXA
OutputDir=installer
OutputBaseFilename=AUREXA_Setup
Compression=lzma
SolidCompression=yes

[Files]
Source: "dist\app_main.exe"; DestDir: "{app}"; Flags: ignoreversion

[Icons]
Name: "{group}\AUREXA CORE"; Filename: "{app}\app_main.exe"
Name: "{userdesktop}\AUREXA CORE"; Filename: "{app}\app_main.exe"

[Run]
Filename: "{app}\app_main.exe"; Description: "Abrir AUREXA"; Flags: nowait postinstall skipifsilent